# Secrets for the anki-mcp stack.
# Copy to .env and fill in. The values below are the only ones that should
# be customised; everything else lives in compose.yaml.

# Anki username/password whose collection is exposed by the sync server.
# (The volume layout is /sync/<username>/collection.anki2 — anki-sync splits
# the value at the first ":" and uses the *username* as the profile directory
# name. The password (or PHC-format hash if PASSWORDS_HASHED=1) follows it.)
SYNC_USER1=<your-anki-username>:<your-password>

# Username part of SYNC_USER1 — needed by the anki-mcp service because the
# compose-interpolation layer does not understand bash substring expansion
# (${SYNC_USER1%%:*}). Keep these two in sync manually.
SYNC_USER1_NAME=<your-anki-username>

# Bearer token MCP clients must send on every request
# (Authorization: Bearer <ANKI_MCP_TOKEN>). Generate with:
#   openssl rand -hex 32
ANKI_MCP_TOKEN=<your-mcp-bearer-token>