# Secrets for the anki-mcp stack.
# Copy to .env and fill in. The values below are the only ones that should
# be customised; everything else lives in compose.yaml.
#
# The MCP server's own bearer token (ANKI_MCP_TOKEN) is NOT stored here.
# It is pulled at container start from the secret manager referenced by the
# INFISICAL_* variables below. The token never lives on disk.

# Anki username whose collection is exposed by the sync server.
# (The volume layout is /sync/<SYNC_USER1>/collection.anki2 — the username
# becomes the profile directory name.)
SYNC_USER1=matthias

# --- Secret-manager configuration (used by the mcp entrypoint) ---
# Service-account token with read access to the INFISICAL_SECRET_PATH folder
# inside the INFISICAL_PROJECT_ID project, INFISICAL_ENV environment.
# Scoped to read-only; should NOT have write access.
INFISICAL_TOKEN=change-me-to-infisical-service-account-token

INFISICAL_PROJECT_ID=828ccbe7-a931-4e75-87de-45a5feff6699
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/anki-mcp
INFISICAL_SITE_URL=https://infisical.sa-ma.online
